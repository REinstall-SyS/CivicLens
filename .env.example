# The local CLI defaults to SQLite. Compose supplies PostgreSQL automatically.
# DATABASE_URL=postgresql+psycopg://civic:localcivic@localhost:5432/civic
POSTGRES_PASSWORD=localcivic
ADMIN_TOKEN=
CORS_ORIGIN=http://localhost:3000
SECURE_COOKIES=false
# Optional LLM accepting OpenAI-style JSON chat completions.
LLM_ENDPOINT=
LLM_MODEL=
LLM_API_KEY=
# For PostgreSQL hybrid ranking, set both values.
PYTHON_EXTRAS=
EMBEDDING_MODEL=
# PYTHON_EXTRAS=[semantic]
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
